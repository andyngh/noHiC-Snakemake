#------------------------------------------------------------------------------#
#     Default config & command-line arguments                                  #
#------------------------------------------------------------------------------#

# Change a config key on the command line through Snakemake's --config
# option, using the argument names in ARGS below:
#
#   snakemake --cores 20 --config reads=hifi.fastq.gz pk_k=31 as_craq=no
#
# Every argument points to exactly one key of config/nohic.yaml. An argument that
# is not given, or given empty (pk_k=), keeps the default value from config/nohic.yaml.

#---- Legal arguments ----#
ARGS = {
    # stages
    "run_refpick":   ("stages", "refpick"),
